{
  "name": "external-opener",
  "displayName": "External Opener",
  "description": "在资源管理器中点击文件时，用配置绑定的外部应用打开，而不是在 VS Code 编辑器中打开。",
  "version": "0.1.0",
  "publisher": "kai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "externalOpener.launcher",
        "displayName": "External Application",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "externalOpener.syncAssociations",
        "title": "External Opener: 同步文件关联"
      }
    ],
    "configuration": {
      "title": "External Opener",
      "properties": {
        "externalOpener.associations": {
          "type": "object",
          "default": {},
          "markdownDescription": "glob → 外部应用。值可以是：\n- `\"default\"`：系统默认程序\n- 可执行文件路径，如 `\"C:/Program Files/SumatraPDF/SumatraPDF.exe\"`（文件路径作为参数传入）\n- 含 `${file}` 的命令模板，如 `\"\\\"C:/app.exe\\\" --open \\\"${file}\\\"\"`\n\n示例：`{ \"*.pdf\": \"default\", \"*.drawio\": \"C:/Program Files/draw.io/draw.io.exe\" }`",
          "additionalProperties": {
            "type": "string"
          }
        },
        "externalOpener.closeTab": {
          "type": "boolean",
          "default": true,
          "description": "启动外部应用后自动关闭 VS Code 中的占位标签页。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FeNgkAIY/vscode-external-opener.git"
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
